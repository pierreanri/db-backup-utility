#!/usr/bin/env sh
# Copyright (c) 2026 pierreanri (https://github.com/pierreanri). All rights reserved.
# No license is granted to use, copy, modify or distribute this file without permission.
# Launcher for the dbbackup CLI. Looks for dbbackup.jar next to this script, in ../lib or in
# ../target (after `mvn package`), and runs it with the first java found. Symbolic links to the
# script are followed, so it can be linked from a directory in the PATH.
set -e

SCRIPT="$0"
while [ -h "$SCRIPT" ]; do
    LINK=$(readlink "$SCRIPT")
    case "$LINK" in
        /*) SCRIPT="$LINK" ;;
        *) SCRIPT="$(dirname -- "$SCRIPT")/$LINK" ;;
    esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)

if [ -n "$DBBACKUP_JAR" ]; then
    JAR="$DBBACKUP_JAR"
else
    for candidate in "$SCRIPT_DIR/dbbackup.jar" "$SCRIPT_DIR/../lib/dbbackup.jar" "$SCRIPT_DIR/../target/dbbackup.jar"; do
        if [ -f "$candidate" ]; then
            JAR="$candidate"
            break
        fi
    done
fi

if [ -z "$JAR" ]; then
    echo "dbbackup: cannot find dbbackup.jar (build it with 'mvn package' or set DBBACKUP_JAR)" >&2
    exit 1
fi

if [ -n "$JAVA_HOME" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA=java
fi

exec "$JAVA" $DBBACKUP_JAVA_OPTS -jar "$JAR" "$@"
